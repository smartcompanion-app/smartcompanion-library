{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "jsxSingleQuote": false,
  "quoteProps": "consistent",
  "printWidth": 180,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "packages/ui/loader/",
    "packages/ui/storybook-static/",
    "package-lock.json",
    "coverage/",
    "CHANGELOG.md",
    "packages/ui/src/components.d.ts",
    "packages/ui/custom-elements.json"
  ]
}
