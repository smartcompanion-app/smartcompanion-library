{
  "name": "@smartcompanion/data",
  "description": "Domain models and data layer for SmartCompanion apps — tours, stations, assets, languages, storage, loading and updates.",
  "version": "1.0.2",
  "keywords": [
    "smartcompanion",
    "audioguide",
    "museum",
    "tours",
    "stations",
    "offline",
    "data-layer"
  ],
  "homepage": "https://github.com/smartcompanion-app/smartcompanion-library/tree/main/packages/data#readme",
  "bugs": {
    "url": "https://github.com/smartcompanion-app/smartcompanion-library/issues"
  },
  "author": "SmartCompanion Team <hello@smartcompanion.app> (https://smartcompanion.app) ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartcompanion-app/smartcompanion-library.git",
    "directory": "packages/data"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "check:publish": "publint . && attw --pack . --ignore-rules cjs-resolves-to-esm"
  },
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  }
}
