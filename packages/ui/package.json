{
  "name": "@smartcompanion/ui",
  "version": "0.9.0",
  "author": "SmartCompanion Team <hello@smartcompanion.app> (https://smartcompanion.app) ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartcompanion-app/smartcompanion-library.git",
    "directory": "packages/ui"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/smartcompanion-ui/smartcompanion-ui.esm.js",
  "files": [
    "src/",
    "dist/",
    "loader/",
    "!**/*.stories.*",
    "!**/*.snapshot.*",
    "!**/*.browser.*",
    "!**/*.test.*",
    "!**/*.spec.*"
  ],
  "license": "BSD-2-Clause",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "stencil build",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "check:publish": "publint . && attw --pack .",
    "test": "stencil-test",
    "watch": "stencil build --watch",
    "storybook": "rm -rf dist/components && STORYBOOK=true storybook dev -p 6006 --no-open",
    "build-storybook": "rm -rf dist/components && STORYBOOK=true storybook build"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "swiper": "^14.0.6"
  },
  "peerDependencies": {
    "@smartcompanion/data": ">=0.9.0"
  },
  "devDependencies": {
    "@smartcompanion/data": "^0.9.0",
    "@smartcompanion/services": "^0.9.0",
    "@stencil/core": "^4.43.3",
    "@stencil/storybook-plugin": "^0.7.0",
    "@stencil/vitest": "^1.11.3",
    "@types/node": "^26.1.2",
    "@vitest/browser-playwright": "^4.1.4",
    "storybook": "^10.5.2"
  }
}
