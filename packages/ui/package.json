{
  "name": "@smartcompanion/ui",
  "description": "Stencil web components for SmartCompanion audio-guide apps — station lists, player controls, maps and more.",
  "version": "0.10.0",
  "keywords": [
    "smartcompanion",
    "audioguide",
    "museum",
    "stencil",
    "web-components",
    "ionic",
    "maplibre"
  ],
  "homepage": "https://github.com/smartcompanion-app/smartcompanion-library/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/smartcompanion-app/smartcompanion-library/issues"
  },
  "author": "SmartCompanion Team <hello@smartcompanion.app> (https://smartcompanion.app) ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartcompanion-app/smartcompanion-library.git",
    "directory": "packages/ui"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/smartcompanion-ui/smartcompanion-ui.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "node": "./dist/index.cjs.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "node": "./loader/index.cjs.js",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js",
      "default": "./loader/index.js"
    },
    "./dist/collection/*": "./dist/collection/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs.js",
    "./dist/esm/*",
    "./dist/cjs/*",
    "./dist/components/*",
    "./loader/*",
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "src/",
    "dist/",
    "loader/",
    "!**/*.stories.*",
    "!**/*.snapshot.*",
    "!**/*.browser.*",
    "!**/*.test.*",
    "!**/*.spec.*"
  ],
  "license": "BSD-2-Clause",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "stencil build",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "check:publish": "publint . && attw --pack . --ignore-rules named-exports",
    "test": "stencil-test",
    "watch": "stencil build --watch",
    "storybook": "rm -rf dist/components && STORYBOOK=true storybook dev -p 6006 --no-open",
    "build-storybook": "rm -rf dist/components && STORYBOOK=true storybook build"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "swiper": "^14.0.7"
  },
  "peerDependencies": {
    "@smartcompanion/data": ">=0.9.0"
  },
  "devDependencies": {
    "@smartcompanion/data": "^0.10.0",
    "@smartcompanion/services": "^0.10.0",
    "@stencil/core": "^4.43.3",
    "@stencil/storybook-plugin": "^0.7.0",
    "@stencil/vitest": "^1.11.3",
    "@types/node": "^26.1.2",
    "@vitest/browser-playwright": "^4.1.4",
    "storybook": "^10.5.2"
  }
}
