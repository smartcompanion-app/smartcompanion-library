exports[`accessibility > sc-image-slideshow has only its known violations 1`] = `
[
  {
    "nodes": [
      "sc-image-slideshow,.swiper-slide-active > img",
      "sc-image-slideshow,.swiper-slide-next > img",
    ],
    "rule": "image-alt (critical): Images must have alternative text",
  },
  {
    "nodes": [
      "sc-image-slideshow,ion-icon[name="chevron-back-outline"]",
      "sc-image-slideshow,ion-icon[name="chevron-forward-outline"]",
    ],
    "rule": "role-img-alt (serious): [role="img"] and [role="image"] elements must have alternative text",
  },
]
`;

